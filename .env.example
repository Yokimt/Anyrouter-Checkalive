# Codex Keepalive - local configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# Everything here can also be passed as environment variables.

# Required: Codex API keys, one per line (a comma separated list also works).
CODEX_TOKENS="sk-xxx111
sk-xxx222"

# Optional: endpoint and model
# BASE_URL="https://anyrouter.top/v1"
# MODEL="gpt-6-astra"
# API_STYLE="auto"          # auto | responses | chat

# Optional: request tuning
# REQUEST_TIMEOUT=90        # seconds per request
# MAX_OUTPUT_TOKENS=128     # output budget (includes reasoning tokens)
# REASONING_EFFORT=low      # set empty to omit reasoning/text fields
# STREAM=1                  # 1 = SSE, 0 = plain JSON

# Optional: QQ email report (leave empty to skip email)
# QQ_EMAIL="yourname@qq.com"
# QQ_SMTP_AUTH_CODE="your_smtp_auth_code"

# Optional: keepalive / monitor timing
# SLEEP_BETWEEN_TOKENS=30
# SLEEP_BETWEEN_ROUNDS=3000
# MAX_DURATION_SEC=21500
# POLL_INTERVAL=1800
# FAST_THRESHOLD_SEC=30
